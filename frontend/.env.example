# Durbeen Frontend Environment Variables Example

# Client-side Backend API Base URL
# Local Development: http://localhost:4000
# Production (Vercel): https://api.yourdomain.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Client-side Media Base URL (Optional: defaults to API Base URL if omitted)
# Production (Vercel): https://api.yourdomain.com/media
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:4000
